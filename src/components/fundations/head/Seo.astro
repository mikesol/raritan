---
import { AstroSeo } from "@lexingtonthemes/seo";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Raritan",
  description = "Mike Solomon's original songs.",
} = Astro.props;

const siteUrl = "https://raritan.music";
const canonical = `${siteUrl}${Astro.url.pathname}`;
const pageTitle = title === "Raritan" ? "Raritan" : `${title} — Raritan`;
---

<AstroSeo
  title={pageTitle}
  description={description}
  canonical={canonical}
  openGraph={{
    url: canonical,
    title: pageTitle,
    description: description,
    site_name: "Raritan",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    handle: "@stronglynormal",
    site: "@stronglynormal",
    cardType: "summary_large_image",
  }}
/>
