---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
const id = `modal-${alt.toLowerCase().replace(/[^a-z0-9]/g, "-").slice(0, 40)}`;

const thumb = await getImage({ src, width: 600, format: "webp", quality: 80 });
const full = await getImage({ src, width: 1400, format: "webp", quality: 85 });
---

<figure class="my-8">
  <button
    onclick={`document.getElementById('${id}').showModal()`}
    class="block w-full text-left p-0 border-0 bg-transparent cursor-zoom-in"
    aria-label={caption ?? alt}
  >
    <div class="thumb-wrap">
      <img
        src={thumb.src}
        alt={alt}
        class="img-fade"
        onload="this.classList.add('loaded')"
      />
    </div>
    {caption && (
      <figcaption class="img-caption">{caption}</figcaption>
    )}
  </button>
</figure>

<dialog id={id} onclick="this.close()" class="img-modal">
  <img
    src={full.src}
    alt={alt}
    class="img-fade"
    onload="this.classList.add('loaded')"
  />
</dialog>

<script is:inline>
  // Handle images already loaded from cache before onload fires
  document.querySelectorAll(".img-fade").forEach(function (img) {
    if (img.complete) img.classList.add("loaded");
  });
</script>

<style>
  .thumb-wrap {
    height: 200px;
    overflow: hidden;
    border-radius: 4px;
    background: #f0f0f0;
  }
  .thumb-wrap .img-fade {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: top;
  }
  .img-caption {
    font-size: 0.7rem;
    text-align: center;
    margin-top: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #aaa;
  }
  .img-modal {
    padding: 0;
    border: none;
    border-radius: 6px;
    max-width: min(90vw, 700px);
    width: 100%;
    margin: auto;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
  }
  .img-modal .img-fade {
    width: 100%;
    display: block;
  }
  .img-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
  .img-fade {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .img-fade.loaded {
    opacity: 1;
  }
</style>
